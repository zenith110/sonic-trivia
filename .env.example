# =================================
# Sonic Trivia - Environment Variables
# =================================

# Copy this file to .env and fill in the values
# cp .env.example .env

# =================================
# Database Configuration
# =================================

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database?sslmode=disable
DATABASE_URL=postgresql://sonic_trivia:sonic_trivia_pass@localhost:5432/sonic_trivia?sslmode=disable

# =================================
# JWT Authentication
# =================================

# Secret key for signing JWT tokens
# IMPORTANT: Change this to a strong, random string in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# =================================
# Server Configuration
# =================================

# Port for the gRPC/Connect server
GRPC_PORT=8080

# =================================
# Cloudflare R2 Storage (Optional)
# =================================

# Required for file uploads (images, audio files)
# Leave empty if not using file storage features

# R2 Account ID from Cloudflare dashboard
R2_ACCOUNT_ID=

# R2 Access Key ID
R2_ACCESS_KEY_ID=

# R2 Secret Access Key
R2_SECRET_ACCESS_KEY=

# R2 Bucket name
R2_BUCKET_NAME=sonic-trivia-assets

# R2 Public URL (if using custom domain)
R2_PUBLIC_URL=

# =================================
# Frontend Configuration
# =================================

# Base URL for API calls from frontend
# This should match where your backend is running
VITE_BASE_API_URL=http://localhost:8080

# =================================
# Development/Production Settings
# =================================

# Application environment (development, staging, production)
APP_ENV=development

# Enable debug logging
DEBUG=true

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =================================
# Database Connection Pool Settings
# =================================

# Maximum number of open connections to the database
DB_MAX_OPEN_CONNS=25

# Maximum number of idle connections
DB_MAX_IDLE_CONNS=5

# Maximum lifetime of a connection (in minutes)
DB_CONN_MAX_LIFETIME=30
ADMIN_PASSWORD=admin
# =================================
# Notes
# =================================

# 1. Never commit the actual .env file to version control
# 2. Keep production secrets secure and separate
# 3. Use strong, unique passwords and keys
# 4. Rotate secrets regularly
# 5. Use environment-specific configurations for dev/staging/prod
